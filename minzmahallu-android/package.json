{
  "name": "minz-mahallu-android",
  "version": "2.0.0",
  "description": "Minz Mahallu Management System \u2014 Android edition (native WebView shell + WebAssembly SQLite)",
  "author": "MMS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "icons": "node scripts/gen-android-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node scripts/smoke-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "test:watch": "vitest",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "apk": "npm run build && node scripts/build-apk.mjs",
    "apk:tools": "node scripts/build-apk.mjs --fetch-only",
    "apk:fast": "node scripts/build-apk.mjs --keep",
    "smoke:apk": "node scripts/smoke-apk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/anek-malayalam": "^5.2.7",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.13.3",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
