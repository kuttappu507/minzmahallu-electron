<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules. Cloud backup keeps the database
  (so a lost phone does not lose the mahallu's records) and device transfer
  carries it to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="file" path="mms-share" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
